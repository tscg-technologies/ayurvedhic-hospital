/* ==========================================================================
   AarogyaVeda Ayurveda Hospital & Holistic Wellness Centre
   Theme & Stylesheet
   Design Concept: Ancient Healing. Modern Wellness.
   ========================================================================== */

/* --------------------------------------------------------------------------
   CSS Custom Properties (Theme Variables)
   -------------------------------------------------------------------------- */
:root {
  /* Brand Palette */
  --color-forest: #244B38;
  --color-forest-dark: #1b382a;
  --color-forest-light: #2e5d46;
  --color-herbal: #66845B;
  --color-herbal-soft: #84a277;
  --color-herbal-pale: #e7ede4;
  --color-terracotta: #B87550;
  --color-terracotta-dark: #9a5f3e;
  --color-terracotta-light: #cb8964;
  --color-terracotta-soft: #f8eee7;
  --color-ivory: #F7F4EA;
  --color-cream: #EFEBDD;
  --color-cream-dark: #e5decb;
  --color-charcoal: #292F29;
  --color-charcoal-muted: #4e584e;
  --color-white: #FFFFFF;
  
  /* Semantic Tokens */
  --bg-primary: var(--color-ivory);
  --bg-secondary: var(--color-cream);
  --bg-surface: var(--color-white);
  --bg-dark: var(--color-forest);
  --text-primary: var(--color-charcoal);
  --text-secondary: var(--color-charcoal-muted);
  --text-light: var(--color-ivory);
  --border-light: rgba(102, 132, 91, 0.2);
  --border-subtle: rgba(41, 47, 41, 0.08);

  /* Typography */
  --font-heading: 'Playfair Display', Georgia, serif;
  --font-body: 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

  /* Shadows */
  --shadow-sm: 0 2px 8px rgba(41, 47, 41, 0.05);
  --shadow-md: 0 8px 24px rgba(36, 75, 56, 0.08);
  --shadow-lg: 0 16px 40px rgba(36, 75, 56, 0.12);
  --shadow-hover: 0 20px 48px rgba(36, 75, 56, 0.16);

  /* Transitions */
  --transition-fast: 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --transition-normal: 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --transition-slow: 0.6s cubic-bezier(0.16, 1, 0.3, 1);

  /* Layout */
  --container-max: 1240px;
  --container-narrow: 920px;
  --header-height: 84px;
  --header-scrolled-height: 72px;
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 14px;
}

/* --------------------------------------------------------------------------
   Reset & Base Styles
   -------------------------------------------------------------------------- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--header-scrolled-height) + 20px);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-body);
  font-weight: 400;
  line-height: 1.68;
  color: var(--text-primary);
  background-color: var(--bg-primary);
  overflow-x: hidden;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
  transition: color var(--transition-fast);
}

button, input, select, textarea {
  font-family: inherit;
  font-size: inherit;
  color: inherit;
}

button {
  cursor: pointer;
  border: none;
  background: none;
}

ul, ol {
  list-style: none;
}

/* --------------------------------------------------------------------------
   Typography Elements
   -------------------------------------------------------------------------- */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: 600;
  color: var(--color-forest);
  line-height: 1.25;
  letter-spacing: -0.01em;
}

h1 {
  font-size: clamp(2.35rem, 4.5vw, 3.85rem);
  font-weight: 700;
}

h2 {
  font-size: clamp(1.85rem, 3.2vw, 2.75rem);
}

h3 {
  font-size: clamp(1.35rem, 2.2vw, 1.85rem);
}

h4 {
  font-size: 1.25rem;
}

p {
  color: var(--text-secondary);
}

.lead {
  font-size: 1.15rem;
  line-height: 1.75;
}

/* Botanical Subtitles & Badges */
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body);
  font-size: 0.82rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--color-terracotta);
  margin-bottom: 12px;
}

.eyebrow::before,
.eyebrow::after {
  content: "";
  display: inline-block;
  width: 24px;
  height: 1px;
  background-color: var(--color-terracotta);
  opacity: 0.6;
}

.eyebrow--no-after::after {
  display: none;
}

.badge {
  display: inline-block;
  padding: 4px 12px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border-radius: 40px;
  background-color: var(--color-herbal-pale);
  color: var(--color-forest);
}

/* --------------------------------------------------------------------------
   Layout Containers & Section Utility
   -------------------------------------------------------------------------- */
.container {
  width: 100%;
  max-width: var(--container-max);
  margin-left: auto;
  margin-right: auto;
  padding-left: 24px;
  padding-right: 24px;
}

.container-narrow {
  max-width: var(--container-narrow);
}

.section {
  padding-top: clamp(64px, 8vw, 112px);
  padding-bottom: clamp(64px, 8vw, 112px);
  position: relative;
}

.section-cream {
  background-color: var(--bg-secondary);
}

.section-ivory {
  background-color: var(--bg-primary);
}

.section-forest {
  background-color: var(--color-forest);
  color: var(--color-ivory);
}

.section-forest h2,
.section-forest h3,
.section-forest h4 {
  color: var(--color-ivory);
}

.section-forest p {
  color: rgba(247, 244, 234, 0.88);
}

.section-forest .eyebrow {
  color: var(--color-terracotta-light);
}

.section-forest .eyebrow::before,
.section-forest .eyebrow::after {
  background-color: var(--color-terracotta-light);
}

.section-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 56px auto;
}

.section-header p {
  margin-top: 14px;
  font-size: 1.05rem;
}

.text-left {
  text-align: left;
  margin-left: 0;
}

/* Subtle Organic Watermark Background */
.pattern-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: 0.035;
  background-image: radial-gradient(#244B38 1px, transparent 1px);
  background-size: 28px 28px;
}

/* --------------------------------------------------------------------------
   Buttons & CTAs
   -------------------------------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 14px 30px;
  font-weight: 700;
  font-size: 0.95rem;
  letter-spacing: 0.03em;
  border-radius: var(--radius-sm);
  transition: all var(--transition-normal);
  text-align: center;
  white-space: nowrap;
  position: relative;
  overflow: hidden;
}

.btn svg {
  width: 18px;
  height: 18px;
  transition: transform var(--transition-fast);
}

.btn:hover svg {
  transform: translateX(4px);
}

.btn-primary {
  background-color: var(--color-forest);
  color: var(--color-ivory);
  border: 1px solid var(--color-forest);
  box-shadow: 0 4px 14px rgba(36, 75, 56, 0.22);
}

.btn-primary:hover {
  background-color: var(--color-forest-dark);
  border-color: var(--color-forest-dark);
  color: var(--color-white);
  box-shadow: 0 6px 20px rgba(36, 75, 56, 0.32);
  transform: translateY(-2px);
}

.btn-terracotta {
  background-color: var(--color-terracotta);
  color: var(--color-white);
  border: 1px solid var(--color-terracotta);
  box-shadow: 0 4px 14px rgba(184, 117, 80, 0.25);
}

.btn-terracotta:hover {
  background-color: var(--color-terracotta-dark);
  border-color: var(--color-terracotta-dark);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(184, 117, 80, 0.35);
}

.btn-secondary {
  background-color: transparent;
  color: var(--color-forest);
  border: 1.5px solid var(--color-forest);
}

.btn-secondary:hover {
  background-color: var(--color-forest);
  color: var(--color-ivory);
  transform: translateY(-2px);
}

.btn-outline-white {
  background-color: transparent;
  color: var(--color-ivory);
  border: 1.5px solid rgba(247, 244, 234, 0.5);
}

.btn-outline-white:hover {
  background-color: var(--color-ivory);
  color: var(--color-forest);
  border-color: var(--color-ivory);
  transform: translateY(-2px);
}

.btn-sm {
  padding: 9px 20px;
  font-size: 0.88rem;
}

.btn-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  font-size: 0.94rem;
  color: var(--color-terracotta);
  padding: 0;
  background: none;
  border: none;
}

.btn-link::after {
  content: "→";
  font-family: inherit;
  transition: transform var(--transition-fast);
}

.btn-link:hover::after {
  transform: translateX(5px);
}

.btn-link:hover {
  color: var(--color-terracotta-dark);
}

/* --------------------------------------------------------------------------
   Header & Navigation
   -------------------------------------------------------------------------- */
.header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: var(--header-height);
  background-color: rgba(247, 244, 234, 0.94);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 1000;
  border-bottom: 1px solid rgba(102, 132, 91, 0.15);
  transition: all var(--transition-normal);
}

.header.scrolled {
  height: var(--header-scrolled-height);
  background-color: rgba(247, 244, 234, 0.98);
  box-shadow: 0 4px 20px rgba(36, 75, 56, 0.08);
  border-bottom-color: rgba(102, 132, 91, 0.22);
}

.nav-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
}

/* Logo */
.brand-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.brand-emblem {
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, var(--color-forest) 0%, var(--color-herbal) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-ivory);
  box-shadow: 0 4px 10px rgba(36, 75, 56, 0.2);
  flex-shrink: 0;
}

.brand-emblem svg {
  width: 24px;
  height: 24px;
  fill: currentColor;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--color-forest);
  letter-spacing: -0.01em;
  line-height: 1.1;
}

.brand-subtitle {
  font-family: var(--font-body);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-terracotta);
}

/* Nav Menu */
.nav-menu {
  display: flex;
  align-items: center;
  gap: 32px;
}

.nav-link {
  font-size: 0.94rem;
  font-weight: 600;
  color: var(--color-charcoal);
  position: relative;
  padding: 6px 0;
  transition: color var(--transition-fast);
}

.nav-link::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 2px;
  background-color: var(--color-terracotta);
  transition: width var(--transition-fast);
}

.nav-link:hover,
.nav-link.active {
  color: var(--color-forest);
}

.nav-link:hover::after,
.nav-link.active::after {
  width: 100%;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

/* Mobile Toggle */
.mobile-nav-toggle {
  display: none;
  flex-direction: column;
  justify-content: space-around;
  width: 32px;
  height: 24px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
  z-index: 1100;
}

.mobile-nav-toggle span {
  width: 100%;
  height: 2px;
  background-color: var(--color-forest);
  border-radius: 2px;
  transition: all var(--transition-fast);
  transform-origin: 1px;
}

.mobile-nav-toggle.open span:nth-child(1) {
  transform: rotate(45deg);
}

.mobile-nav-toggle.open span:nth-child(2) {
  opacity: 0;
}

.mobile-nav-toggle.open span:nth-child(3) {
  transform: rotate(-45deg);
}

/* --------------------------------------------------------------------------
   Notice Banner (Hospital Fictional Demo Banner)
   -------------------------------------------------------------------------- */
.top-notice-bar {
  background-color: var(--color-forest-dark);
  color: rgba(247, 244, 234, 0.9);
  font-size: 0.78rem;
  padding: 6px 16px;
  text-align: center;
  letter-spacing: 0.02em;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.top-notice-bar strong {
  color: var(--color-white);
  font-weight: 700;
}

/* --------------------------------------------------------------------------
   Hero Section (Split Layout)
   -------------------------------------------------------------------------- */
.hero-section {
  position: relative;
  min-height: calc(100vh - 30px);
  display: flex;
  align-items: center;
  padding-top: calc(var(--header-height) + 50px);
  padding-bottom: 70px;
  background: linear-gradient(180deg, #F7F4EA 0%, #EFEBDD 100%);
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.95fr;
  align-items: center;
  gap: 56px;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero-sanskrit-tag {
  font-family: var(--font-heading);
  font-style: italic;
  font-size: 1.05rem;
  color: var(--color-herbal);
  margin-bottom: 8px;
  letter-spacing: 0.02em;
}

.hero-title {
  margin-bottom: 22px;
  color: var(--color-forest);
}

.hero-lead {
  font-size: 1.15rem;
  color: var(--text-secondary);
  line-height: 1.75;
  margin-bottom: 34px;
  max-width: 580px;
}

.hero-cta-group {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 42px;
}

/* Hero Trust Information Area (Strictly without fabricated certifications) */
.hero-trust-bar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  padding-top: 28px;
  border-top: 1px solid rgba(102, 132, 91, 0.22);
}

.trust-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.trust-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-color: var(--color-herbal-pale);
  color: var(--color-forest);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.trust-icon svg {
  width: 18px;
  height: 18px;
}

.trust-text h5 {
  font-family: var(--font-body);
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--color-forest);
  margin-bottom: 2px;
}

.trust-text p {
  font-size: 0.78rem;
  color: var(--text-secondary);
  line-height: 1.35;
}

/* Hero Visual Composition */
.hero-visual {
  position: relative;
  z-index: 1;
}

.hero-image-frame {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  border: 8px solid var(--color-white);
}

.hero-image-frame img {
  width: 100%;
  height: 520px;
  object-fit: cover;
  transition: transform var(--transition-slow);
}

.hero-image-frame:hover img {
  transform: scale(1.03);
}

/* Decorative Floating Kerala Heritage Badge */
.hero-floating-card {
  position: absolute;
  bottom: -24px;
  left: -28px;
  background-color: var(--color-white);
  padding: 18px 24px;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-hover);
  border: 1px solid rgba(102, 132, 91, 0.18);
  max-width: 250px;
  display: flex;
  align-items: center;
  gap: 14px;
}

.hero-floating-icon {
  width: 44px;
  height: 44px;
  background-color: var(--color-terracotta-soft);
  color: var(--color-terracotta);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-floating-icon svg {
  width: 22px;
  height: 22px;
}

.hero-floating-text h6 {
  font-family: var(--font-heading);
  font-size: 0.95rem;
  color: var(--color-forest);
}

.hero-floating-text p {
  font-size: 0.78rem;
  color: var(--text-secondary);
}

/* --------------------------------------------------------------------------
   About Us Section (Editorial Image & Text)
   -------------------------------------------------------------------------- */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}

.about-visual-group {
  position: relative;
}

.about-main-image {
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 6px solid var(--color-white);
}

.about-main-image img {
  width: 100%;
  height: 460px;
  object-fit: cover;
}

.about-secondary-image {
  position: absolute;
  bottom: -32px;
  right: -24px;
  width: 220px;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-hover);
  border: 5px solid var(--color-white);
}

.about-secondary-image img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.about-pillars {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 32px;
}

.about-pillar-card {
  padding: 18px 20px;
  background-color: var(--color-white);
  border-radius: var(--radius-md);
  border-left: 3px solid var(--color-terracotta);
  box-shadow: var(--shadow-sm);
}

.about-pillar-card h5 {
  font-size: 1rem;
  color: var(--color-forest);
  margin-bottom: 6px;
}

.about-pillar-card p {
  font-size: 0.85rem;
  line-height: 1.5;
}

/* --------------------------------------------------------------------------
   Ayurvedic Treatments Section
   -------------------------------------------------------------------------- */
.treatments-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}

.treatment-card {
  background-color: var(--color-white);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-subtle);
  transition: all var(--transition-normal);
  display: flex;
  flex-direction: column;
}

.treatment-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-hover);
  border-color: rgba(102, 132, 91, 0.3);
}

.treatment-image-wrap {
  position: relative;
  height: 230px;
  overflow: hidden;
}

.treatment-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-slow);
}

.treatment-card:hover .treatment-image-wrap img {
  transform: scale(1.06);
}

.treatment-dosha-tag {
  position: absolute;
  top: 14px;
  left: 14px;
  background-color: rgba(36, 75, 56, 0.85);
  color: var(--color-ivory);
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  backdrop-filter: blur(4px);
}

.treatment-body {
  padding: 26px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.treatment-title {
  font-size: 1.35rem;
  color: var(--color-forest);
  margin-bottom: 6px;
}

.treatment-sanskrit {
  font-size: 0.85rem;
  font-style: italic;
  color: var(--color-herbal);
  margin-bottom: 14px;
}

.treatment-desc {
  font-size: 0.92rem;
  line-height: 1.6;
  color: var(--text-secondary);
  margin-bottom: 20px;
  flex-grow: 1;
}

.treatment-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16px;
  border-top: 1px solid var(--border-subtle);
}

.treatment-duration {
  font-size: 0.8rem;
  color: var(--color-herbal);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* --------------------------------------------------------------------------
   Panchakarma Section (Classical Fivefold Purification)
   -------------------------------------------------------------------------- */
.panchakarma-section {
  background-color: var(--color-forest);
  color: var(--color-ivory);
  position: relative;
}

.panchakarma-grid {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 56px;
  align-items: center;
}

.panchakarma-lead-box {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-md);
  padding: 30px;
  margin-top: 24px;
  backdrop-filter: blur(6px);
}

.panchakarma-room-preview {
  margin-top: 20px;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.16);
  position: relative;
}

.panchakarma-room-preview img {
  width: 100%;
  height: 210px;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform var(--transition-slow);
}

.panchakarma-room-preview:hover img {
  transform: scale(1.04);
}

.panchakarma-room-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 10px 16px;
  background: linear-gradient(180deg, transparent 0%, rgba(20, 45, 33, 0.92) 100%);
  font-size: 0.82rem;
  color: var(--color-ivory);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8px;
}

.panchakarma-notice {
  font-size: 0.82rem;
  color: rgba(247, 244, 234, 0.75);
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  font-style: italic;
}

/* The Five Karma Cards */
.panchakarma-steps {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.karma-card {
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-md);
  padding: 18px 22px;
  transition: all var(--transition-fast);
  cursor: pointer;
}

.karma-card:hover,
.karma-card.active {
  background: rgba(255, 255, 255, 0.14);
  border-color: var(--color-terracotta-light);
  transform: translateX(6px);
}

.karma-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.karma-title-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
}

.karma-number {
  font-family: var(--font-heading);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-terracotta-light);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1px solid var(--color-terracotta-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.karma-title {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--color-ivory);
}

.karma-sanskrit {
  font-size: 0.8rem;
  color: rgba(247, 244, 234, 0.7);
  font-style: italic;
  display: block;
}

.karma-desc {
  font-size: 0.88rem;
  color: rgba(247, 244, 234, 0.85);
  margin-top: 10px;
  line-height: 1.55;
  display: none;
}

.karma-card.active .karma-desc {
  display: block;
}

/* --------------------------------------------------------------------------
   Why Choose Us Section
   -------------------------------------------------------------------------- */
.why-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.why-card {
  background-color: var(--color-white);
  padding: 34px 28px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-normal);
  position: relative;
}

.why-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 28px;
  width: 40px;
  height: 3px;
  background-color: var(--color-terracotta);
  transition: width var(--transition-fast);
}

.why-card:hover::before {
  width: 70px;
}

.why-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-hover);
}

.why-icon-box {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-sm);
  background-color: var(--color-herbal-pale);
  color: var(--color-forest);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}

.why-icon-box svg {
  width: 26px;
  height: 26px;
}

.why-card h4 {
  font-size: 1.2rem;
  margin-bottom: 12px;
  color: var(--color-forest);
}

.why-card p {
  font-size: 0.92rem;
  line-height: 1.6;
}

/* --------------------------------------------------------------------------
   Our Doctors (Fictional Ayurvedic Vaidyas)
   -------------------------------------------------------------------------- */
.doctors-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28px;
}

.doctor-card {
  background-color: var(--color-white);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-subtle);
  transition: all var(--transition-normal);
  display: flex;
  flex-direction: column;
}

.doctor-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-hover);
}

.doctor-image-wrap {
  position: relative;
  height: 290px;
  background-color: var(--color-cream);
  overflow: hidden;
}

.doctor-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  transition: transform var(--transition-slow);
}

.doctor-card:hover .doctor-image-wrap img {
  transform: scale(1.05);
}

.doctor-badge {
  position: absolute;
  bottom: 12px;
  left: 12px;
  background: rgba(36, 75, 56, 0.9);
  color: var(--color-ivory);
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 0.72rem;
  font-weight: 600;
  backdrop-filter: blur(4px);
}

.doctor-info {
  padding: 22px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.doctor-name {
  font-size: 1.18rem;
  color: var(--color-forest);
  margin-bottom: 4px;
}

.doctor-qual {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--color-terracotta);
  margin-bottom: 8px;
  letter-spacing: 0.02em;
}

.doctor-spec {
  font-size: 0.88rem;
  color: var(--text-secondary);
  margin-bottom: 18px;
  flex-grow: 1;
  line-height: 1.45;
}

.doctor-fictional-note {
  font-size: 0.72rem;
  color: #8b968a;
  font-style: italic;
  margin-bottom: 12px;
}

/* --------------------------------------------------------------------------
   Wellness Facilities Section
   -------------------------------------------------------------------------- */
.facility-tabs {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 40px;
}

.facility-tab-btn {
  padding: 10px 22px;
  font-size: 0.9rem;
  font-weight: 600;
  border-radius: 40px;
  background-color: var(--color-white);
  border: 1px solid var(--border-light);
  color: var(--color-forest);
  transition: all var(--transition-fast);
}

.facility-tab-btn:hover,
.facility-tab-btn.active {
  background-color: var(--color-forest);
  color: var(--color-ivory);
  border-color: var(--color-forest);
}

.facilities-gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.facility-card {
  position: relative;
  height: 280px;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  group: "";
}

.facility-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-slow);
}

.facility-card:hover img {
  transform: scale(1.08);
}

.facility-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(27, 56, 42, 0.92) 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 24px;
  color: var(--color-ivory);
  transition: background var(--transition-fast);
}

.facility-card:hover .facility-overlay {
  background: linear-gradient(180deg, rgba(27, 56, 42, 0.2) 0%, rgba(27, 56, 42, 0.95) 100%);
}

.facility-overlay h4 {
  color: var(--color-ivory);
  font-size: 1.2rem;
  margin-bottom: 4px;
}

.facility-overlay p {
  color: rgba(247, 244, 234, 0.85);
  font-size: 0.84rem;
  line-height: 1.4;
}

/* --------------------------------------------------------------------------
   Patient Testimonials (Sample Demonstration)
   -------------------------------------------------------------------------- */
.patient-experience-hero {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 40px;
  align-items: center;
  background-color: var(--color-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--border-subtle);
  margin-bottom: 48px;
}

.patient-experience-img-wrap {
  position: relative;
  height: 100%;
  min-height: 340px;
  overflow: hidden;
}

.patient-experience-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform var(--transition-slow);
}

.patient-experience-hero:hover .patient-experience-img-wrap img {
  transform: scale(1.04);
}

.patient-experience-content {
  padding: 40px 36px 40px 20px;
}

.patient-experience-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 20px;
}

.patient-experience-meta span {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--color-forest);
  background-color: var(--color-herbal-pale);
  padding: 5px 12px;
  border-radius: 20px;
}

@media (max-width: 900px) {
  .patient-experience-hero {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .patient-experience-img-wrap {
    height: 260px;
    min-height: auto;
  }

  .patient-experience-content {
    padding: 28px 24px;
  }
}

.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}

.testimonial-card {
  background-color: var(--color-white);
  padding: 36px 30px;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-subtle);
  position: relative;
  display: flex;
  flex-direction: column;
}

.testimonial-quote-icon {
  font-family: var(--font-heading);
  font-size: 4rem;
  line-height: 1;
  color: var(--color-terracotta-soft);
  position: absolute;
  top: 18px;
  right: 24px;
  user-select: none;
}

.testimonial-text {
  font-size: 0.96rem;
  font-style: italic;
  line-height: 1.7;
  color: var(--text-primary);
  margin-bottom: 24px;
  position: relative;
  z-index: 1;
  flex-grow: 1;
}

.testimonial-author-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
  padding-top: 16px;
  border-top: 1px solid var(--border-subtle);
}

.testimonial-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background-color: var(--color-herbal-pale);
  color: var(--color-forest);
  font-family: var(--font-heading);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
}

.testimonial-author h5 {
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--color-forest);
  margin-bottom: 2px;
}

.testimonial-author span {
  font-size: 0.78rem;
  color: var(--text-secondary);
  display: block;
}

.demo-review-tag {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--color-terracotta);
  background-color: var(--color-terracotta-soft);
  padding: 2px 8px;
  border-radius: 4px;
  margin-top: 4px;
}

/* --------------------------------------------------------------------------
   Interactive Dosha Discovery Mini-Widget
   -------------------------------------------------------------------------- */
.dosha-quiz-section {
  background: linear-gradient(135deg, #EFEBDD 0%, #E5DECB 100%);
  border-radius: var(--radius-lg);
  padding: 44px 38px;
  margin-bottom: 72px;
  border: 1px solid rgba(102, 132, 91, 0.2);
  box-shadow: var(--shadow-sm);
}

.dosha-quiz-header {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 30px auto;
}

.dosha-quiz-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.dosha-option-card {
  background-color: var(--color-white);
  padding: 24px;
  border-radius: var(--radius-md);
  border: 2px solid transparent;
  cursor: pointer;
  transition: all var(--transition-fast);
  text-align: center;
}

.dosha-option-card:hover,
.dosha-option-card.selected {
  border-color: var(--color-forest);
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}

.dosha-icon {
  font-size: 2rem;
  margin-bottom: 10px;
  display: inline-block;
}

.dosha-name {
  font-size: 1.2rem;
  color: var(--color-forest);
  margin-bottom: 6px;
}

.dosha-element {
  font-size: 0.8rem;
  color: var(--color-terracotta);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 10px;
}

.dosha-desc {
  font-size: 0.85rem;
  line-height: 1.45;
  color: var(--text-secondary);
}

.dosha-result-box {
  margin-top: 24px;
  padding: 20px;
  background-color: var(--color-white);
  border-radius: var(--radius-md);
  border-left: 4px solid var(--color-forest);
  display: none;
}

.dosha-result-box.show {
  display: block;
  animation: fadeIn 0.4s ease-in-out;
}

/* --------------------------------------------------------------------------
   Appointment Booking Section
   -------------------------------------------------------------------------- */
.booking-section {
  position: relative;
  background-color: var(--color-ivory);
}

.booking-grid {
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: 56px;
  align-items: flex-start;
}

.booking-info-box {
  padding-right: 16px;
}

.booking-feature-list {
  margin-top: 28px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.booking-feature-item {
  display: flex;
  gap: 16px;
}

.booking-feature-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background-color: var(--color-herbal-pale);
  color: var(--color-forest);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.booking-feature-icon svg {
  width: 20px;
  height: 20px;
}

.booking-feature-text h5 {
  font-size: 1rem;
  color: var(--color-forest);
  margin-bottom: 4px;
}

.booking-feature-text p {
  font-size: 0.88rem;
  line-height: 1.45;
}

/* Booking Form Container */
.booking-form-card {
  background-color: var(--color-white);
  padding: 44px 40px;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border-light);
}

.form-title {
  font-size: 1.65rem;
  color: var(--color-forest);
  margin-bottom: 6px;
}

.form-subtitle {
  font-size: 0.88rem;
  color: var(--text-secondary);
  margin-bottom: 28px;
}

.form-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.form-group {
  margin-bottom: 20px;
  position: relative;
}

.form-label {
  display: block;
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--color-forest);
  margin-bottom: 8px;
}

.form-label .required {
  color: var(--color-terracotta);
}

.form-control {
  width: 100%;
  padding: 13px 16px;
  font-size: 0.95rem;
  background-color: var(--color-ivory);
  border: 1.5px solid rgba(41, 47, 41, 0.12);
  border-radius: var(--radius-sm);
  color: var(--color-charcoal);
  transition: all var(--transition-fast);
  outline: none;
}

.form-control:focus {
  background-color: var(--color-white);
  border-color: var(--color-forest);
  box-shadow: 0 0 0 3px rgba(36, 75, 56, 0.12);
}

.form-control.error {
  border-color: #d9534f;
  background-color: #fff9f9;
}

.error-msg {
  font-size: 0.78rem;
  color: #c9302c;
  margin-top: 5px;
  display: none;
}

.form-control.error + .error-msg {
  display: block;
}

textarea.form-control {
  resize: vertical;
  min-height: 100px;
}

.booking-demo-disclaimer {
  font-size: 0.78rem;
  color: var(--color-charcoal-muted);
  line-height: 1.45;
  margin-top: 14px;
  padding: 10px 14px;
  background-color: var(--color-terracotta-soft);
  border-radius: var(--radius-sm);
  border-left: 3px solid var(--color-terracotta);
}

/* --------------------------------------------------------------------------
   FAQ Accordion Section
   -------------------------------------------------------------------------- */
.faq-container {
  max-width: 820px;
  margin: 0 auto;
}

.faq-item {
  background-color: var(--color-white);
  border-radius: var(--radius-md);
  margin-bottom: 16px;
  border: 1px solid var(--border-subtle);
  overflow: hidden;
  transition: border-color var(--transition-fast);
}

.faq-item.active {
  border-color: var(--color-herbal);
}

.faq-question {
  width: 100%;
  padding: 22px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--color-forest);
  cursor: pointer;
  background: none;
  border: none;
  transition: color var(--transition-fast);
}

.faq-question:hover {
  color: var(--color-terracotta);
}

.faq-icon {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background-color: var(--color-cream);
  color: var(--color-forest);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  flex-shrink: 0;
  transition: transform var(--transition-normal);
}

.faq-item.active .faq-icon {
  transform: rotate(45deg);
  background-color: var(--color-terracotta);
  color: var(--color-white);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height var(--transition-normal);
}

.faq-answer-inner {
  padding: 0 24px 22px 24px;
  font-size: 0.94rem;
  color: var(--text-secondary);
  line-height: 1.65;
}

/* --------------------------------------------------------------------------
   Contact & Location Section
   -------------------------------------------------------------------------- */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
}

.contact-card {
  background-color: var(--color-white);
  padding: 38px;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-subtle);
}

.contact-details-list {
  display: flex;
  flex-direction: column;
  gap: 24px;
  margin-top: 28px;
}

.contact-detail-item {
  display: flex;
  align-items: flex-start;
  gap: 18px;
}

.contact-icon-box {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background-color: var(--color-herbal-pale);
  color: var(--color-forest);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.contact-icon-box svg {
  width: 20px;
  height: 20px;
}

.contact-text h5 {
  font-size: 0.95rem;
  font-family: var(--font-body);
  font-weight: 700;
  color: var(--color-forest);
  margin-bottom: 2px;
}

.contact-text p,
.contact-text a {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.5;
}

.contact-text a:hover {
  color: var(--color-terracotta);
}

/* Map Representation Placeholder */
.map-frame-box {
  background-color: var(--color-cream);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-light);
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 400px;
}

.map-visual-placeholder {
  position: relative;
  flex-grow: 1;
  min-height: 320px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px;
  background-color: var(--color-forest);
}

.map-bg-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: brightness(0.85);
  transition: transform var(--transition-slow);
}

.map-frame-box:hover .map-bg-img {
  transform: scale(1.04);
}

.map-visual-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(36, 75, 56, 0.4) 0%, rgba(27, 56, 42, 0.8) 100%);
  pointer-events: none;
}

.map-pin-card {
  background-color: var(--color-white);
  padding: 22px 26px;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  max-width: 320px;
  text-align: center;
  position: relative;
  z-index: 2;
  border: 1px solid rgba(102, 132, 91, 0.2);
}

.map-pin-icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background-color: var(--color-terracotta);
  color: var(--color-white);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: -40px auto 12px auto;
  box-shadow: 0 4px 12px rgba(184, 117, 80, 0.4);
}

.map-pin-icon svg {
  width: 24px;
  height: 24px;
}

.map-pin-card h5 {
  font-size: 1.1rem;
  color: var(--color-forest);
  margin-bottom: 4px;
}

.map-pin-card p {
  font-size: 0.82rem;
  color: var(--text-secondary);
}

.map-footer-bar {
  padding: 16px 24px;
  background-color: var(--color-forest);
  color: var(--color-ivory);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.map-footer-bar span {
  font-size: 0.85rem;
}

/* WhatsApp Quick Button CTA */
.whatsapp-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background-color: #25D366;
  color: #FFFFFF;
  padding: 12px 24px;
  border-radius: var(--radius-sm);
  font-weight: 700;
  font-size: 0.92rem;
  transition: all var(--transition-normal);
  margin-top: 16px;
}

.whatsapp-cta-btn:hover {
  background-color: #1ebe5d;
  color: #FFFFFF;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(37, 211, 102, 0.3);
}

.whatsapp-cta-btn svg {
  width: 20px;
  height: 20px;
  fill: currentColor;
}

/* --------------------------------------------------------------------------
   Footer
   -------------------------------------------------------------------------- */
.footer {
  background-color: var(--color-forest-dark);
  color: var(--color-ivory);
  padding-top: 80px;
  padding-bottom: 30px;
  border-top: 4px solid var(--color-terracotta);
}

.footer-top {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
  gap: 48px;
  padding-bottom: 56px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-brand p {
  color: rgba(247, 244, 234, 0.78);
  font-size: 0.92rem;
  line-height: 1.65;
  margin-top: 18px;
  margin-bottom: 24px;
}

.footer-social-links {
  display: flex;
  gap: 12px;
}

.social-icon-link {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  color: var(--color-ivory);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
}

.social-icon-link:hover {
  background-color: var(--color-terracotta);
  color: var(--color-white);
  transform: translateY(-3px);
}

.social-icon-link svg {
  width: 18px;
  height: 18px;
  fill: currentColor;
}

.footer-heading {
  font-family: var(--font-heading);
  font-size: 1.2rem;
  color: var(--color-ivory);
  margin-bottom: 22px;
  position: relative;
}

.footer-heading::after {
  content: "";
  position: absolute;
  bottom: -8px;
  left: 0;
  width: 30px;
  height: 2px;
  background-color: var(--color-terracotta);
}

.footer-links-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-links-list a {
  font-size: 0.9rem;
  color: rgba(247, 244, 234, 0.75);
  transition: all var(--transition-fast);
  display: inline-block;
}

.footer-links-list a:hover {
  color: var(--color-terracotta-light);
  transform: translateX(4px);
}

.footer-contact-info li {
  font-size: 0.88rem;
  color: rgba(247, 244, 234, 0.75);
  margin-bottom: 12px;
  line-height: 1.5;
}

.footer-contact-info strong {
  color: var(--color-ivory);
}

.footer-bottom {
  padding-top: 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
  font-size: 0.82rem;
  color: rgba(247, 244, 234, 0.6);
}

.footer-disclaimer-box {
  width: 100%;
  margin-top: 14px;
  padding: 12px 18px;
  background: rgba(0, 0, 0, 0.2);
  border-radius: var(--radius-sm);
  font-size: 0.76rem;
  line-height: 1.5;
  color: rgba(247, 244, 234, 0.7);
}

/* --------------------------------------------------------------------------
   Modals & Popups
   -------------------------------------------------------------------------- */
.modal-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(27, 56, 42, 0.75);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--transition-normal), visibility var(--transition-normal);
}

.modal-overlay.open {
  opacity: 1;
  visibility: visible;
}

.modal-container {
  background-color: var(--color-white);
  border-radius: var(--radius-lg);
  max-width: 620px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: var(--shadow-lg);
  position: relative;
  transform: scale(0.92) translateY(20px);
  transition: transform var(--transition-normal);
}

.modal-overlay.open .modal-container {
  transform: scale(1) translateY(0);
}

.modal-close-btn {
  position: absolute;
  top: 18px;
  right: 18px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-color: var(--color-cream);
  color: var(--color-forest);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  border: none;
  cursor: pointer;
  transition: all var(--transition-fast);
  z-index: 10;
}

.modal-close-btn:hover {
  background-color: var(--color-terracotta);
  color: var(--color-white);
}

.modal-header-image {
  height: 220px;
  width: 100%;
  object-fit: cover;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.modal-content-body {
  padding: 32px;
}

.modal-title {
  font-size: 1.6rem;
  color: var(--color-forest);
  margin-bottom: 6px;
}

.modal-subtitle {
  font-size: 0.9rem;
  color: var(--color-herbal);
  font-style: italic;
  margin-bottom: 18px;
}

.modal-text {
  font-size: 0.95rem;
  line-height: 1.65;
  color: var(--text-secondary);
  margin-bottom: 24px;
}

.modal-attributes {
  background-color: var(--color-ivory);
  border-radius: var(--radius-md);
  padding: 16px 20px;
  margin-bottom: 24px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.modal-attr-item h6 {
  font-family: var(--font-body);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-terracotta);
  margin-bottom: 2px;
}

.modal-attr-item p {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--color-forest);
}

/* Confirmation Success Modal */
.success-modal-icon {
  width: 68px;
  height: 68px;
  border-radius: 50%;
  background-color: var(--color-herbal-pale);
  color: var(--color-forest);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px auto;
}

.success-modal-icon svg {
  width: 36px;
  height: 36px;
}

.success-summary-box {
  background-color: var(--color-ivory);
  padding: 16px 20px;
  border-radius: var(--radius-md);
  margin: 20px 0;
  text-align: left;
  font-size: 0.88rem;
  border-left: 3px solid var(--color-forest);
}

.success-summary-box p {
  margin-bottom: 6px;
  color: var(--color-charcoal);
}

.success-summary-box p strong {
  color: var(--color-forest);
}

/* --------------------------------------------------------------------------
   Back to Top Button
   -------------------------------------------------------------------------- */
.back-to-top {
  position: fixed;
  bottom: 28px;
  right: 28px;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background-color: var(--color-forest);
  color: var(--color-ivory);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-md);
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-normal);
  z-index: 990;
  border: 1px solid rgba(247, 244, 234, 0.2);
}

.back-to-top.show {
  opacity: 1;
  visibility: visible;
}

.back-to-top:hover {
  background-color: var(--color-terracotta);
  transform: translateY(-4px);
  box-shadow: var(--shadow-hover);
}

.back-to-top svg {
  width: 20px;
  height: 20px;
}

/* Floating WhatsApp Demo Trigger */
.floating-whatsapp {
  position: fixed;
  bottom: 84px;
  right: 28px;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background-color: #25D366;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
  z-index: 990;
  transition: all var(--transition-normal);
}

.floating-whatsapp:hover {
  transform: scale(1.1) translateY(-2px);
  box-shadow: 0 6px 20px rgba(37, 211, 102, 0.5);
}

.floating-whatsapp svg {
  width: 26px;
  height: 26px;
  fill: currentColor;
}

/* --------------------------------------------------------------------------
   Keyframe Animations
   -------------------------------------------------------------------------- */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* --------------------------------------------------------------------------
   Responsive Design & Media Queries
   -------------------------------------------------------------------------- */
@media (max-width: 1024px) {
  .hero-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .hero-visual {
    max-width: 600px;
    margin: 0 auto;
  }

  .treatments-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .panchakarma-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .why-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .doctors-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .facilities-gallery-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .testimonials-grid {
    grid-template-columns: 1fr;
    max-width: 680px;
    margin: 0 auto;
  }

  .booking-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .contact-grid {
    grid-template-columns: 1fr;
  }

  .footer-top {
    grid-template-columns: repeat(2, 1fr);
    gap: 36px;
  }
}

@media (max-width: 768px) {
  .mobile-nav-toggle {
    display: flex;
  }

  .nav-menu {
    position: fixed;
    top: var(--header-height);
    right: -100%;
    width: 82%;
    max-width: 360px;
    height: calc(100vh - var(--header-height));
    background-color: var(--color-white);
    flex-direction: column;
    align-items: flex-start;
    padding: 36px 28px;
    gap: 20px;
    box-shadow: -8px 0 24px rgba(0, 0, 0, 0.1);
    transition: right var(--transition-normal);
    overflow-y: auto;
  }

  .nav-menu.open {
    right: 0;
  }

  .nav-link {
    font-size: 1.1rem;
    width: 100%;
    padding: 8px 0;
  }

  .nav-actions {
    display: none;
  }

  .nav-menu .nav-actions-mobile {
    display: block;
    width: 100%;
    margin-top: 16px;
  }

  .hero-trust-bar {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .about-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .about-secondary-image {
    position: static;
    width: 100%;
    margin-top: 16px;
  }

  .about-secondary-image img {
    height: 240px;
  }

  .treatments-grid {
    grid-template-columns: 1fr;
  }

  .why-grid {
    grid-template-columns: 1fr;
  }

  .doctors-grid {
    grid-template-columns: 1fr;
    max-width: 380px;
    margin: 0 auto;
  }

  .facilities-gallery-grid {
    grid-template-columns: 1fr;
  }

  .dosha-quiz-options {
    grid-template-columns: 1fr;
  }

  .form-grid-2 {
    grid-template-columns: 1fr;
  }

  .booking-form-card {
    padding: 28px 20px;
  }

  .contact-card {
    padding: 28px 20px;
  }

  .footer-top {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .footer-bottom {
    flex-direction: column;
    text-align: center;
  }

  .hero-floating-card {
    position: static;
    margin-top: 16px;
    max-width: 100%;
  }
}

